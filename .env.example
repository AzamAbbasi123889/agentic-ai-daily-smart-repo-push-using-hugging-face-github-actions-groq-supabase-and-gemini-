# Local development only. Never commit .env or real secrets.
GITHUB_OWNER=AzamAbbasi123889
# Primary generator: Groq OpenAI-compatible API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini review + second-choice fallback generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Hugging Face Inference Providers specification optimizer (not an initial generation fallback)
# Requires a user token with Inference Providers permission
HF_TOKEN=
HF_OPTIMIZER_MODEL=openai/gpt-oss-120b:fastest
# Supabase project memory. A server-side secret/service-role key is required by this private workflow.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy Supabase service_role key is also supported:
SUPABASE_SERVICE_ROLE_KEY=
# Optional fine-grained/PAT token to include private repositories in novelty checks.
# Without this, the factory scans public repositories for the GitHub owner above.
GH_TOKEN=
